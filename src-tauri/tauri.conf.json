{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome 密钥库",
  "version": "0.1.0",
  "identifier": "app.rhizome.vault",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rhizome",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "createUpdaterArtifacts": false,
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../THIRD-PARTY-NOTICES.md": "legal/THIRD-PARTY-NOTICES.md",
      "../docs/legal/privacy-policy.zh-CN.md": "legal/privacy-policy.zh-CN.md",
      "../docs/legal/privacy-policy.en-US.md": "legal/privacy-policy.en-US.md",
      "../docs/legal/terms-of-use.zh-CN.md": "legal/terms-of-use.zh-CN.md",
      "../docs/legal/terms-of-use.en-US.md": "legal/terms-of-use.en-US.md",
      "../docs/legal/licenses/": "legal/licenses/",
      "../docs/legal/sources/": "legal/sources/",
      "../docs/legal/release-license-review.md": "legal/release-license-review.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": null
    }
  }
}
